#!/bin/sh

if has_cmdline setupnet; then
	if ! SetupNetwork; then
		ewarn "networking setup failed; continuing boot."
	fi
fi
if has_cmdline "debug"; then
	echo 7 > /proc/sys/kernel/printk
fi
if has_cmdline "quiet"; then
	initramfs_quiet=true
fi
if has_cmdline "format-swap"; then
	einfo "Formatting Orbis Swap as a Linux swap partition..."
	mkswap /dev/sda31 > /dev/null
	einfo "Done!"
fi
