#!/bin/sh

target_dev=''
if [ -d /newroot ] && mountpoint -q /newroot; then
	target_dev="$(findmnt -n -o SOURCE /newroot 2>/dev/null)"
fi
[ -n "${target_dev}" ] || return 0

diskpart="${target_dev##*/}"
diskbase="${target_dev%[0-9]*}"
[ -b "${diskbase}" ] || return 0

disklabel=''
case "$(blkid -o value -s LABEL "${target_dev}" 2>/dev/null)" in
	''|*[!0-9A-Za-z_\-]*) ;;
	*) disklabel="${_}" ;;
esac
if [ "${disklabel}" != 'PSXITARCH' ]; then
	return 0
fi

parts=''
for p in "${diskbase}"[0-9]*; do
	[ -b "${p}" ] && parts="${parts} ${p}"
done
case "${parts}" in
	' '*) ewarn "Only single-partition disks are handled here."; return 0 ;;
	*) return 0 ;;
esac

lbs='512'
if [ -r "/sys/block/${diskbase##*/}/queue/logical_block_size" ]; then
	lbs="$(cat "/sys/block/${diskbase##*/}/queue/logical_block_size" 2>/dev/null)"
fi
if [ "${lbs}" != '512' ]; then
	ewarn "Only 512-byte logical block devices are handled here."
	return 0
fi

disk_sectors='0'
if [ -r "/sys/block/${diskbase##*/}/size" ]; then
	disk_sectors="$(cat "/sys/block/${diskbase##*/}/size" 2>/dev/null)"
fi
case "${disk_sectors}" in
	''|*[!0-9]*) ewarn "Could not read the size of ${diskbase}."; return 0 ;;
esac

part_first='0'
part_last='0'
if [ -r "/sys/block/${diskbase##*/}/${diskpart}/start" ]; then
	part_first="$(cat "/sys/block/${diskbase##*/}/${diskpart}/start" 2>/dev/null)"
fi
if [ -r "/sys/block/${diskbase##*/}/${diskpart}/size" ]; then
	part_last="$(cat "/sys/block/${diskbase##*/}/${diskpart}/size" 2>/dev/null)"
fi
if [ "${part_first}" -eq 0 ] || [ "${part_last}" -eq 0 ]; then
	ewarn "Could not read partition geometry for ${target_dev}."
	return 0
fi
part_last=$(( part_first + part_last - 1 ))

disk_gb=$(( disk_sectors * 512 / 1073741824 ))
part_gb=$(( part_last * 512 / 1073741824 ))
unused_gb=$(( (disk_sectors - (part_last + 1)) * 512 / 1073741824 ))

if [ "${unused_gb}" -le 0 ]; then
	return 0
fi

einfo "External PSXITARCH install on ${target_dev}."
einfo "Disk: about ${disk_gb} GB. Partition: about ${part_gb} GB. Unused: about ${unused_gb} GB."
eask "The disk is larger than the PSXITARCH partition. Expand the partition to fill the disk? (yes/no): "
read answer
case "${answer}" in
	[yY]*) ;;
	*) return 0 ;;
esac
eask "This will grow the filesystem to use the whole disk. Continue? (yes/no): "
read confirm
case "${confirm}" in
	[yY]*) ;;
	*) return 0 ;;
esac

if grep -q " ${target_dev} " /proc/mounts 2>/dev/null; then
	ewarn "${target_dev} is currently mounted. Cannot safely repartition."
	return 1
fi

printf 'o\nn\np\n1\n%d\n%d\nw\n' "${part_first}" "${disk_sectors}" | fdisk -u "${diskbase}" >/dev/null 2>&1
if [ $? -ne 0 ]; then
	teerror "fdisk failed on ${diskbase}."
	return 1
fi

if ! blockdev --rereadpt "${diskbase}" 2>/dev/null; then
	if command -v partprobe >/dev/null 2>&1; then
		partprobe "${diskbase}" 2>/dev/null || ewarn "partprobe failed; a reboot may be needed."
	else
		ewarn "Could not re-read the partition table on ${diskbase}."
		return 1
	fi
fi

newname="${diskbase}1"
n=0
while ! [ -b "${newname}" ]; do
	n=$((n + 1))
	if [ "${n}" -gt 10 ]; then
		teerror "Partition ${newname} did not reappear."
		return 1
	fi
	sleep 1
done

fs_type=''
case "$(blkid -o value -s TYPE "${newname}" 2>/dev/null)" in
	ext2*|ext4*) fs_type='ext4' ;;
	btrfs*) fs_type='btrfs' ;;
esac

if [ "${fs_type}" = 'ext4' ]; then
	if ! e2fsck -f "${newname}"; then
		tewarn "e2fsck reported issues on ${newname}."
	fi
	if ! resize2fs "${newname}"; then
		teerror "Could not resize the ext4 filesystem on ${newname}."
		return 1
	fi
else
	if ! btrfs check "${newname}"; then
		tewarn "btrfs check reported issues on ${newname}."
	fi
	if ! mount -o ro "${newname}" /mnt 2>/dev/null; then
		mkdir -p /mnt
		if ! mount -o ro "${newname}" /mnt 2>/dev/null; then
			teerror "Could not mount ${newname} to resize btrfs."
			return 1
		fi
	fi
	if ! btrfs filesystem resize max /mnt; then
		teerror "Could not resize the btrfs filesystem on ${newname}."
		umount /mnt 2>/dev/null
		return 1
	fi
	umount /mnt 2>/dev/null
fi

einfo "Expanded ${target_dev} to fill ${diskbase} (about ${disk_gb} GB)."
