#!/bin/sh

img=/ps4hdd/app/linux.img
limit_gb=10

if [ ! -f "${img}" ]; then
	return 0
fi

current_bytes='0'
case "$(stat -c %s "${img}" 2>/dev/null)" in
	''|*[!0-9]*) ;;
	*) current_bytes="${_}" ;;
esac

if [ "${current_bytes}" -eq 0 ]; then
	ewarn "Could not determine the size of ${img}; skipping."
	return 0
fi

current_gb=$(( current_bytes / 1073741824 ))

if [ "${current_gb}" -ge "${limit_gb}" ]; then
	return 0
fi

einfo "The Linux image ${img} is currently about ${current_gb} GB."
eask "It is smaller than ${limit_gb} GB. Do you wish to resize it? (yes/no): "
read answer
case "${answer}" in
	[yY]*) ;;
	*) return 0 ;;
esac

eask "Enter the new size in GB (at least ${current_gb}): "
read size
case "${size}" in
	''|*[!0-9]*)
		teerror "'${size}' is not a number."
		return 1
	;;
esac
if [ "${size}" -lt "${current_gb}" ]; then
	teerror "New size must be at least the current size (${current_gb} GB)."
	return 1
fi

new_bytes=$(( size * 1073741824 ))
if [ "${new_bytes}" -eq "${current_bytes}" ]; then
	einfo "No change requested."
	return 0
fi

if ! truncate -s "${new_bytes}" "${img}"; then
	teerror "Could not resize ${img}."
	return 1
fi

fs_type=''
case "$(blkid -o value -s TYPE "${img}" 2>/dev/null)" in
	ext2*|ext4*) fs_type='ext4' ;;
	btrfs*) fs_type='btrfs' ;;
esac

if [ "${fs_type}" = 'ext4' ]; then
	if ! e2fsck -f "${img}"; then
		tewarn "e2fsck reported issues on ${img}."
	fi
	if ! resize2fs "${img}" "${new_bytes}"; then
		teerror "Could not resize the ext4 filesystem in ${img}."
		return 1
	fi
else
	if ! btrfs check "${img}"; then
		tewarn "btrfs check reported issues on ${img}."
	fi
	if ! mount -o loop,ro "${img}" /mnt 2>/dev/null; then
		if ! mkdir -p /mnt && mount -o loop,ro "${img}" /mnt 2>/dev/null; then
			teerror "Could not mount ${img} to resize btrfs."
			return 1
		fi
	fi
	if ! btrfs filesystem resize "${new_bytes}" /mnt; then
		teerror "Could not resize the btrfs filesystem in ${img}."
		umount /mnt 2>/dev/null
		return 1
	fi
	umount /mnt 2>/dev/null
fi

einfo "Resized ${img} to ${size} GB."
